DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST/SHADOW_DATABASE?sslmode=require"
ORDER_EXPORT_FIELDS_AVAILABLE="false"
APP_TIME_ZONE="Europe/London"
REPORT_ARTIFACT_STORAGE_ROOT=".local-report-artifacts"
CARRIER_EXPORT_ARTIFACT_STORAGE_ROOT=".local-carrier-export-artifacts"
AUTH_SECRET="replace-with-a-secure-random-secret"
SEED_ADMIN_EMAIL="admin@example.test"
SEED_ADMIN_PASSWORD="replace-with-a-development-password"
SEED_PLANNER_EMAIL="planner@example.test"
SEED_PLANNER_PASSWORD="replace-with-a-development-password"
